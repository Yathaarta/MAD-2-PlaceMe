# ==============================================================================
# GLOBAL / OS / EDITOR FILES (Apply to whole repo)
# ==============================================================================

# OS junk files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.AppleDouble
.LSOverride

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/
tmp/


# ==============================================================================
# BACKEND (Python / Flask / Celery) - "backend/" folder
# ==============================================================================

# Virtual Environments (Anywhere in repo)
venv/
env/
.venv/
.env

# Compiled Python files (Anywhere in repo)
__pycache__/
*.py[cod]
*$py.class

# Flask Specifics
backend/instance/       # Local database & config folder
backend/.env            # API Keys & Secrets (CRITICAL)
backend/.flaskenv
backend/secrets.py

# Celery & Redis
celerybeat-schedule
celerybeat.pid
dump.rdb

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/


# ==============================================================================
# DATABASE (SQLite)
# ==============================================================================
# Ignore local database files so they don't get overwritten by others
*.sqlite3
*.db
*.sqlite


# ==============================================================================
# FRONTEND (Vue.js / Vite / Node) - "frontend/" folder
# ==============================================================================

# Dependencies
node_modules/
frontend/node_modules/

# Build Outputs
frontend/dist/
dist/
build/
dist-ssr/

# Local Environment Configs
frontend/.env
frontend/.env.local
frontend/.env.*.local
*.local

# Vite/Lint Caches & Temp Files
.eslintcache
frontend/.vite/
*.timestamp-*-*.mjs
*.tsbuildinfo

# Node Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend Testing Artifacts
coverage/
cypress/videos/
cypress/screenshots/
__screenshots__/


# ==============================================================================
# PERSONAL DOCUMENTATION (Your diagrams)
# ==============================================================================

# Excalidraw files (Your personal sketches)
*.excalidraw
*.excalidraw.json